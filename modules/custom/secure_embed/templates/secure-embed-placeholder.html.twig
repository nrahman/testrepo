{#
/**
 * @file
 * Template for secure embed placeholder (shown in CKEditor).
 *
 * Available variables:
 * - label: The placeholder label text.
 */
#}
<div class="secure-embed-placeholder">
  <span class="secure-embed-placeholder__icon" aria-hidden="true">📹</span>
  <span class="secure-embed-placeholder__label">{{ label|default('[Secure Embed]') }}</span>
</div>
