{#
/**
 * @file
 * Template for secure embed error messages.
 *
 * Available variables:
 * - message: The error message to display.
 */
#}
<div class="secure-embed-error" role="alert">
  <span class="secure-embed-error__icon" aria-hidden="true">⚠</span>
  <span class="secure-embed-error__message">{{ message }}</span>
</div>
