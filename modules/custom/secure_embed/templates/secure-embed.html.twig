{#
/**
 * @file
 * Template for secure embed iframe wrapper.
 *
 * Available variables:
 * - wrapper_attributes: HTML attributes for the wrapper div.
 * - iframe_attributes: HTML attributes for the iframe element.
 * - responsive: Boolean indicating responsive mode.
 *
 * @see \Drupal\secure_embed\Service\SecureEmbedManager::buildRenderArray()
 */
#}
{% set wrapper_attrs = create_attribute(wrapper_attributes) %}
{% set iframe_attrs = create_attribute(iframe_attributes) %}

<div{{ wrapper_attrs }}>
  <iframe{{ iframe_attrs }}></iframe>
</div>
