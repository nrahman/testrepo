<?php

/**
 * @file
 * Secure Embed module file.
 *
 * Provides a secure way to embed external content via CKEditor
 * with domain whitelisting, HMAC-signed tokens, and sanitized parameters.
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function secure_embed_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.secure_embed':
      $output = '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('The Secure Embed module provides a secure method for embedding external content (like YouTube videos, maps, or other iframes) into your content.') . '</p>';
      $output .= '<h3>' . t('Security Features') . '</h3>';
      $output .= '<ul>';
      $output .= '<li>' . t('<strong>Domain Whitelisting:</strong> Only URLs from approved domains can be embedded.') . '</li>';
      $output .= '<li>' . t('<strong>HMAC Signed Tokens:</strong> Embed tokens are cryptographically signed to prevent tampering.') . '</li>';
      $output .= '<li>' . t('<strong>HTTPS Only:</strong> Only secure HTTPS URLs are allowed.') . '</li>';
      $output .= '<li>' . t('<strong>Parameter Sanitization:</strong> All embed parameters are sanitized before rendering.') . '</li>';
      $output .= '<li>' . t('<strong>No Raw HTML:</strong> Users never enter raw iframe code directly.') . '</li>';
      $output .= '<li>' . t('<strong>CSP Compatible:</strong> Embeds use secure sandbox attributes.') . '</li>';
      $output .= '</ul>';
      $output .= '<h3>' . t('Usage') . '</h3>';
      $output .= '<p>' . t('Click the "Secure Embed" button in CKEditor to insert an embed. Enter the URL and configure display options.') . '</p>';
      $output .= '<h3>' . t('Extending') . '</h3>';
      $output .= '<p>' . t('Implement hook_secure_embed_validate_alter(), hook_secure_embed_params_alter(), or hook_secure_embed_render_alter() to customize behavior.') . '</p>';
      return $output;

    case 'secure_embed.settings':
      return '<p>' . t('Configure the allowed domains and default settings for secure embeds.') . '</p>';
  }
}

/**
 * Implements hook_theme().
 */
function secure_embed_theme($existing, $type, $theme, $path) {
  return [
    'secure_embed' => [
      'variables' => [
        'wrapper_attributes' => [],
        'iframe_attributes' => [],
        'responsive' => TRUE,
      ],
      'template' => 'secure-embed',
      'path' => $path . '/templates',
    ],
    'secure_embed_error' => [
      'variables' => [
        'message' => '',
      ],
      'template' => 'secure-embed-error',
      'path' => $path . '/templates',
    ],
    'secure_embed_placeholder' => [
      'variables' => [
        'label' => '',
      ],
      'template' => 'secure-embed-placeholder',
      'path' => $path . '/templates',
    ],
  ];
}

/**
 * Implements hook_config_schema_info_alter().
 */
function secure_embed_cache_flush() {
  // Clear domain pattern cache when caches are flushed.
  \Drupal::service('secure_embed.manager')->clearCache();
}

/**
 * Validates a URL against the whitelist.
 *
 * @param string $url
 *   The URL to validate.
 *
 * @return bool
 *   TRUE if the URL is from an allowed domain, FALSE otherwise.
 *
 * @deprecated in secure_embed:2.0.0 and is removed from secure_embed:3.0.0.
 *   Use \Drupal::service('secure_embed.manager')->validateUrl() instead.
 */
function secure_embed_validate_url($url) {
  return \Drupal::service('secure_embed.manager')->validateUrl($url);
}

/**
 * Sanitizes embed parameters.
 *
 * @param array $params
 *   The raw parameters.
 *
 * @return array
 *   Sanitized parameters.
 *
 * @deprecated in secure_embed:2.0.0 and is removed from secure_embed:3.0.0.
 *   Use \Drupal::service('secure_embed.manager')->sanitizeParams() instead.
 */
function secure_embed_sanitize_params(array $params) {
  return \Drupal::service('secure_embed.manager')->sanitizeParams($params);
}

/**
 * Encodes embed data for storage in content.
 *
 * @param array $data
 *   The embed data.
 *
 * @return string
 *   Signed, base64 encoded JSON string.
 *
 * @deprecated in secure_embed:2.0.0 and is removed from secure_embed:3.0.0.
 *   Use \Drupal::service('secure_embed.manager')->encodeData() instead.
 */
function secure_embed_encode_data(array $data) {
  return \Drupal::service('secure_embed.manager')->encodeData($data);
}

/**
 * Decodes embed data from content.
 *
 * @param string $encoded
 *   Signed, base64 encoded JSON string.
 *
 * @return array|null
 *   The decoded data or NULL on failure/invalid signature.
 *
 * @deprecated in secure_embed:2.0.0 and is removed from secure_embed:3.0.0.
 *   Use \Drupal::service('secure_embed.manager')->decodeData() instead.
 */
function secure_embed_decode_data($encoded) {
  return \Drupal::service('secure_embed.manager')->decodeData($encoded);
}

/**
 * Gets the default allowed iframe permissions.
 *
 * @return array
 *   Array of allowed permissions.
 */
function secure_embed_get_default_allow() {
  return [
    'accelerometer',
    'autoplay',
    'clipboard-write',
    'encrypted-media',
    'gyroscope',
    'picture-in-picture',
    'web-share',
    'fullscreen',
  ];
}

/**
 * Gets the default sandbox attributes.
 *
 * @return array
 *   Array of sandbox attributes.
 */
function secure_embed_get_default_sandbox() {
  return [
    'allow-scripts',
    'allow-same-origin',
    'allow-popups',
    'allow-presentation',
  ];
}

/**
 * @addtogroup hooks
 * @{
 */

/**
 * Alter the URL validation result.
 *
 * This hook allows modules to override the URL validation decision.
 * Use with caution as this affects security.
 *
 * @param bool $is_valid
 *   The current validation result. Modify to change the outcome.
 * @param string $url
 *   The URL being validated.
 */
function hook_secure_embed_validate_alter(&$is_valid, $url) {
  // Example: Block a specific URL pattern even if domain is allowed.
  if (strpos($url, '/blocked-path/') !== FALSE) {
    $is_valid = FALSE;
  }

  // Example: Allow a specific URL that would otherwise be blocked.
  if ($url === 'https://trusted-internal-site.example.com/embed') {
    $is_valid = TRUE;
  }
}

/**
 * Alter the sanitized embed parameters.
 *
 * This hook allows modules to modify or add parameters after sanitization.
 *
 * @param array $sanitized
 *   The sanitized parameters. Modify in place.
 * @param array $original
 *   The original unsanitized parameters for reference.
 */
function hook_secure_embed_params_alter(array &$sanitized, array $original) {
  // Example: Force all embeds to use lazy loading.
  $sanitized['lazy_loading'] = TRUE;

  // Example: Add a tracking parameter.
  if (!empty($sanitized['url'])) {
    $sanitized['url'] .= (strpos($sanitized['url'], '?') !== FALSE ? '&' : '?') . 'ref=drupal';
  }
}

/**
 * Alter the embed render array before rendering.
 *
 * This hook allows modules to modify the render array for embeds.
 *
 * @param array $build
 *   The render array. Modify in place.
 * @param array $embed_data
 *   The embed data used to generate the render array.
 */
function hook_secure_embed_render_alter(array &$build, array $embed_data) {
  // Example: Add a custom wrapper class.
  $build['#wrapper_attributes']['class'][] = 'my-custom-embed-class';

  // Example: Add custom cache tags.
  $build['#cache']['tags'][] = 'my_module:embeds';

  // Example: Add additional JavaScript.
  $build['#attached']['library'][] = 'my_module/embed_tracking';
}

/**
 * @} End of "addtogroup hooks".
 */
